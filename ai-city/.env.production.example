# AI City Production Core profile. Copy to .env.production and replace every
# replace-with-secret value. Never commit the filled-in file.
AICITY_ENV=production

# PostgreSQL
POSTGRES_USER=aicity
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=aicity

# Shared application secrets
JWT_SECRET=replace-with-at-least-32-byte-random-secret
ADMIN_PORTAL_JWT_SECRET=replace-with-separate-admin-secret
ADMIN_TOKEN=replace-with-admin-api-token
CROSS_CITY_SERVICE_TOKEN=replace-with-cross-city-token

# Public browser URLs. These must be reachable from the player browser.
PUBLIC_WEB_URL=https://city.example.com
PUBLIC_API_GATEWAY_URL=https://api.example.com
PUBLIC_WS_GATEWAY_URL=wss://ws.example.com/ws

# Optional host-port mappings behind a reverse proxy.
WEB_HOST_PORT=3000
API_GATEWAY_HOST_PORT=8080
WS_GATEWAY_HOST_PORT=8082
A2A_HTTP_HOST_PORT=8083
ADMIN_PORTAL_HOST_PORT=8081

# City identity for cross-city federation.
CITY_ID=city_a
A2A_EXPECTED_PEER_CN=a2a-gateway-city-b
