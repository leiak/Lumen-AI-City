# AI City Production Core profile. Copy to .env.production and replace every
# replace-with-secret value. Never commit the filled-in file.
AICITY_ENV=production

# PostgreSQL
POSTGRES_USER=aicity
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=aicity

# Shared application secrets
JWT_SECRET=replace-with-at-least-32-byte-random-secret
REDIS_PASSWORD=replace-with-redis-password
ADMIN_PORTAL_JWT_SECRET=replace-with-separate-admin-secret
ADMIN_TOKEN=replace-with-admin-api-token
CROSS_CITY_SERVICE_TOKEN=replace-with-cross-city-token
OPERATOR_API_KEY=replace-with-operator-api-token

# Per-service Redis ACL credentials. Each identity receives least privilege.
REDIS_ACL_PASSWORD_PROBE=replace-with-redis-probe-password
REDIS_ACL_PASSWORD_METRICS=replace-with-redis-metrics-password
REDIS_ACL_PASSWORD_WORLD_ENGINE=replace-with-redis-world-engine-password
REDIS_ACL_PASSWORD_AGENT_OS=replace-with-redis-agent-os-password
REDIS_ACL_PASSWORD_API_GATEWAY=replace-with-redis-api-gateway-password
REDIS_ACL_PASSWORD_WS_GATEWAY=replace-with-redis-ws-gateway-password
REDIS_ACL_PASSWORD_A2A_GATEWAY=replace-with-redis-a2a-gateway-password
REDIS_ACL_PASSWORD_ECONOMY=replace-with-redis-economy-password

# Milvus object storage. Never use minioadmin in production.
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-at-least-16-byte-minio-password
MILVUS_MINIO_BUCKET=aicity-milvus

# Optional observability stack. Start with:
# docker compose --profile observability ...
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# Public browser URLs. These must be reachable from the player browser.
PUBLIC_WEB_URL=https://city.example.com
PUBLIC_API_GATEWAY_URL=https://api.example.com
PUBLIC_WS_GATEWAY_URL=wss://ws.example.com/ws
PUBLIC_A2A_GATEWAY_URL=https://a2a.example.com

# Optional host-port mappings behind a reverse proxy.
WEB_HOST_PORT=3000
API_GATEWAY_HOST_PORT=8080
EDGE_GATEWAY_HOST_PORT=80
WS_GATEWAY_HOST_PORT=8082
A2A_HTTP_HOST_PORT=8083
ADMIN_PORTAL_HOST_PORT=8081

# City identity for cross-city federation.
CITY_ID=city_a
A2A_EXPECTED_PEER_CN=a2a-gateway-city-b
