# admin-portal — Next.js 15 运营后台
# 复制到 .env.local 后修改，本文件不进 git（仓库根 .gitignore 已排除 .env.local）。
#
# 所有 ADMIN_PORTAL_* 由 src/lib/economy.ts / src/lib/auth.ts 读取；
# 容器侧同名 env 在 docker-compose.yml 注入（fallback = 同名 dev 值）。

# JWT 签名密钥（src/lib/auth.ts HS256）。与 api-gateway/ws-gateway 的 JWT_SECRET
# 共用同源时，登录 cookie 才能在 admin-portal 解码成功。
ADMIN_PORTAL_JWT_SECRET=dev-secret-change-me

# economy-service base URL（src/lib/economy.ts:6,26）。容器内用 compose 服务名；
# 本地 pnpm dev 时改成 http://localhost:8005。
ADMIN_PORTAL_ECONOMY_URL=http://economy-service:8005

# /api/economy/admin/* 路由需要的 Bearer token（src/lib/economy.ts:35）。
# 与 economy-service 的 ADMIN_TOKEN 共用同源（api/v1/admin.py:12 默认值）。
ADMIN_PORTAL_ADMIN_TOKEN=dev-admin-token