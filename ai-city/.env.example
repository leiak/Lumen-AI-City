# ============================================
# AI City - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ----- 应用 -----
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=ai-city

# ----- 数据库（PostgreSQL）-----
DATABASE_URL=postgresql://aicity:aicity_dev@localhost:5432/aicity
PG_POOL_MIN=5
PG_POOL_MAX=50

# ----- 缓存（Redis）-----
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_URL=

# ----- Redis ACL（生产必须覆盖；本机 Compose 默认仅用于开发） -----
REDIS_ACL_PASSWORD_PROBE=acl_probe_dev
REDIS_ACL_PASSWORD_WORLD_ENGINE=world_engine_dev
REDIS_ACL_PASSWORD_AGENT_OS=agent_os_dev
REDIS_ACL_PASSWORD_API_GATEWAY=api_gateway_dev
REDIS_ACL_PASSWORD_WS_GATEWAY=ws_gateway_dev
REDIS_ACL_PASSWORD_A2A_GATEWAY=a2a_gateway_dev
REDIS_ACL_PASSWORD_ECONOMY=economy_dev

# ----- 消息总线（Kafka）-----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=aicity-dev

# ----- 图数据库（Neo4j）-----
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev

# ----- 向量数据库（Milvus）-----
MILVUS_URL=localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=milvus_dev

# ----- LLM -----
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
LITELLM_BASE_URL=http://localhost:4000
LLM_PRIMARY_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_DAILY_BUDGET_USD=5000

# ----- JWT / 鉴权 -----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY=3600
ADMIN_TOKEN=dev-admin-token
ADMIN_PORTAL_JWT_SECRET=dev-secret-change-me
CROSS_CITY_SERVICE_TOKEN=dev-cross-city-service-token
OPERATOR_API_KEY=dev-operator-token-change-me

# ----- API Gateway -----
API_GATEWAY_PORT=8080
# Docker 宿主机映射端口；默认 8080，本机冲突时可改为 18080。
API_GATEWAY_HOST_PORT=8080
WS_GATEWAY_PORT=8082

# ----- A2A 联邦 -----
A2A_GATEWAY_PORT=8083
A2A_FEDERATION_DISCOVERY_URL=
CITY_ID=city_a
A2A_EXPECTED_PEER_CN=a2a-gateway-city-b

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ----- Production Core（不要把 .env.production 提交到 Git）-----
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_GATEWAY_URL=http://localhost:8080
PUBLIC_WS_GATEWAY_URL=ws://localhost:8082/ws

# ----- Push 通知 -----
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_SERVER_KEY=
