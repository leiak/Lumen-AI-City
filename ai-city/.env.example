# ============================================
# AI City - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ----- 应用 -----
NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=ai-city

# ----- 数据库（PostgreSQL）-----
DATABASE_URL=postgresql://aicity:aicity_dev@localhost:5432/aicity
PG_POOL_MIN=5
PG_POOL_MAX=50

# ----- 缓存（Redis）-----
REDIS_URL=redis://localhost:6379/0
REDIS_CLUSTER_URL=

# ----- 消息总线（Kafka）-----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=aicity-dev

# ----- 图数据库（Neo4j）-----
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev

# ----- 向量数据库（Milvus）-----
MILVUS_URL=localhost:19530
MILVUS_USER=root
MILVUS_PASSWORD=milvus_dev

# ----- LLM -----
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
LITELLM_BASE_URL=http://localhost:4000
LLM_PRIMARY_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
LLM_DAILY_BUDGET_USD=5000

# ----- JWT / 鉴权 -----
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY=3600

# ----- API Gateway -----
API_GATEWAY_PORT=8080
WS_GATEWAY_PORT=8082

# ----- A2A 联邦 -----
A2A_GATEWAY_PORT=8083
A2A_FEDERATION_DISCOVERY_URL=

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ----- Push 通知 -----
APNS_KEY_ID=
APNS_TEAM_ID=
FCM_SERVER_KEY=
